"""
BUILD.bazel - Main build file for WebAssembly Micro Runtime (WAMR)

This file defines the main vmlib target which combines all WAMR components.
For JIT support, use the vmlib_jit target which requires LLVM.
"""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Main WAMR runtime library (vmlib/libiwasm)
# Default configuration: Interpreter + AOT (no JIT)
cc_library(
    name = "vmlib",
    hdrs = glob(["core/iwasm/include/*.h"]),
    copts = [
        "-std=gnu99",
        "-Wall",
        "-Wextra",
        "-Wformat",
        "-Wformat-security",
        "-ffunction-sections",
        "-fdata-sections",
        "-fvisibility=hidden",
        "-DWASM_ENABLE_INTERP=1",
        "-DWASM_ENABLE_AOT=1",
        "-DWASM_ENABLE_LIBC_BUILTIN=1",
        "-DWASM_ENABLE_LIBC_WASI=1",
        "-DWASM_ENABLE_FAST_INTERP=1",
        "-DWASM_ENABLE_SIMD=1",
        "-DWASM_ENABLE_REF_TYPES=1",
    ] + select({
        "@platforms//cpu:x86_64": ["-DBUILD_TARGET_X86_64"],
        "@platforms//cpu:aarch64": ["-DBUILD_TARGET_AARCH64"],
        "@platforms//cpu:arm": ["-DBUILD_TARGET_ARM"],
        "@platforms//cpu:riscv64": ["-DBUILD_TARGET_RISCV64_LP64D"],
        "//conditions:default": ["-DBUILD_TARGET_X86_64"],
    }),
    includes = ["core/iwasm/include"],
    linkopts = select({
        "@platforms//os:linux": [
            "-lm",
            "-ldl",
            "-lpthread",
        ],
        "@platforms//os:macos": [
            "-lm",
            "-lpthread",
        ],
        "@platforms//os:windows": [
            "-lws2_32",
            "-lntdll",
        ],
        "//conditions:default": [
            "-lm",
            "-ldl",
            "-lpthread",
        ],
    }),
    deps = [
        "//core/iwasm/aot",
        "//core/iwasm/common",
        "//core/iwasm/interpreter",
        "//core/iwasm/libraries/libc-builtin",
        "//core/iwasm/libraries/libc-wasi",
        "//core/shared/mem-alloc",
        "//core/shared/platform",
        "//core/shared/utils",
    ],
)

# WAMR runtime library with JIT support
# Requires LLVM dependency: bazel_dep(name = "llvm-project", version = "17.0.3.bcr.4")
cc_library(
    name = "vmlib_jit",
    hdrs = glob(["core/iwasm/include/*.h"]),
    copts = [
        "-std=gnu99",
        "-Wall",
        "-Wextra",
        "-Wformat",
        "-Wformat-security",
        "-ffunction-sections",
        "-fdata-sections",
        "-fvisibility=hidden",
        "-DWASM_ENABLE_INTERP=1",
        "-DWASM_ENABLE_AOT=1",
        "-DWASM_ENABLE_JIT=1",
        "-DWASM_ENABLE_LAZY_JIT=1",
        "-DWASM_ENABLE_LIBC_BUILTIN=1",
        "-DWASM_ENABLE_LIBC_WASI=1",
        "-DWASM_ENABLE_FAST_INTERP=0",  # JIT mode uses classic interpreter
        "-DWASM_ENABLE_SIMD=1",
        "-DWASM_ENABLE_REF_TYPES=1",
    ] + select({
        "@platforms//cpu:x86_64": ["-DBUILD_TARGET_X86_64"],
        "@platforms//cpu:aarch64": ["-DBUILD_TARGET_AARCH64"],
        "@platforms//cpu:arm": ["-DBUILD_TARGET_ARM"],
        "@platforms//cpu:riscv64": ["-DBUILD_TARGET_RISCV64_LP64D"],
        "//conditions:default": ["-DBUILD_TARGET_X86_64"],
    }),
    includes = ["core/iwasm/include"],
    linkopts = select({
        "@platforms//os:linux": [
            "-lm",
            "-ldl",
            "-lpthread",
        ],
        "@platforms//os:macos": [
            "-lm",
            "-lpthread",
        ],
        "@platforms//os:windows": [
            "-lws2_32",
            "-lntdll",
        ],
        "//conditions:default": [
            "-lm",
            "-ldl",
            "-lpthread",
        ],
    }),
    deps = [
        "//core/iwasm/aot",
        "//core/iwasm/common",
        "//core/iwasm/interpreter",
        "//core/iwasm/libraries/libc-builtin",
        "//core/iwasm/libraries/libc-wasi",
        "//core/shared/mem-alloc",
        "//core/shared/platform",
        "//core/shared/utils",
        # JIT compilation component would be added here when implemented
        # "//core/iwasm/compilation",
    ] + [
        # LLVM core libraries required for JIT
        "@llvm-project//llvm:ExecutionEngine",
        "@llvm-project//llvm:MCJIT",
        "@llvm-project//llvm:OrcJIT",
        "@llvm-project//llvm:Support",
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:Target",
        "@llvm-project//llvm:MC",
        "@llvm-project//llvm:Object",
        "@llvm-project//llvm:Analysis",
        "@llvm-project//llvm:Passes",
        "@llvm-project//llvm:TransformUtils",
        "@llvm-project//llvm:ScalarOpts",
        "@llvm-project//llvm:InstCombine",
        "@llvm-project//llvm:CodeGen",
        "@llvm-project//llvm:SelectionDAG",
        "@llvm-project//llvm:AsmPrinter",
        "@llvm-project//llvm:BitWriter",
        "@llvm-project//llvm:BitReader",
        "@llvm-project//llvm:IRReader",
        "@llvm-project//llvm:Vectorize",
        "@llvm-project//llvm:IPO",
        "@llvm-project//llvm:Linker",
        "@llvm-project//llvm:Instrumentation",
        "@llvm-project//llvm:JITLink",
    ] + select({
        # Architecture-specific LLVM libraries
        "@platforms//cpu:x86_64": [
            "@llvm-project//llvm:X86CodeGen",
            "@llvm-project//llvm:X86AsmParser",
            "@llvm-project//llvm:X86Disassembler",
        ],
        "@platforms//cpu:aarch64": [
            "@llvm-project//llvm:AArch64CodeGen",
            "@llvm-project//llvm:AArch64AsmParser",
            "@llvm-project//llvm:AArch64Disassembler",
        ],
        "@platforms//cpu:arm": [
            "@llvm-project//llvm:ARMCodeGen",
            "@llvm-project//llvm:ARMAsmParser",
            "@llvm-project//llvm:ARMDisassembler",
        ],
        "@platforms//cpu:riscv64": [
            "@llvm-project//llvm:RISCVCodeGen",
            "@llvm-project//llvm:RISCVAsmParser",
            "@llvm-project//llvm:RISCVDisassembler",
        ],
        "//conditions:default": [
            # Default to x86_64 for unknown architectures
            "@llvm-project//llvm:X86CodeGen",
            "@llvm-project//llvm:X86AsmParser",
            "@llvm-project//llvm:X86Disassembler",
        ],
    }),
)

# Alias for compatibility
alias(
    name = "iwasm",
    actual = ":vmlib",
)

# Alias for JIT-enabled build
alias(
    name = "iwasm_jit",
    actual = ":vmlib_jit",
)
