"""
MODULE.bazel - Bazel module definition for WebAssembly Micro Runtime (WAMR)

This file defines the WAMR module and its dependencies using Bazel's modern
module system (bzlmod). It provides build support for the WAMR runtime library
without requiring foreign_cc rules.

For JIT support (WAMR_BUILD_JIT=1), LLVM 19.1.0 is included automatically.
Projects using //:vmlib_jit will get LLVM via git_override.

For projects using only //:vmlib (default), LLVM is not required.

See BAZEL.md for complete JIT configuration instructions.
"""

module(
    name = "wamr",
    version = "2.4.3",
    compatibility_level = 1,
)

# Core Bazel rules for C/C++ compilation
# Note: These versions are updated to match Bazel's dependency resolution
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.4")

# Optional: Bazel skylib for utility functions
bazel_dep(name = "bazel_skylib", version = "1.8.2")

# LLVM for JIT support - using version 17.0.3.bcr.4 from Bazel Central Registry
# BCR versions include the necessary overlays (MODULE.bazel, BUILD files) for bzlmod support
# This provides the LLVM targets we need (Support, Core, OrcJIT, etc.)
# Note: LLVM 19+ is not yet available in BCR. When it becomes available, update this version.
bazel_dep(name = "llvm-project", version = "17.0.3.bcr.4", dev_dependency = True)
