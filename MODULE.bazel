"""
MODULE.bazel - Bazel module definition for WebAssembly Micro Runtime (WAMR)

This file defines the WAMR module and its dependencies using Bazel's modern
module system (bzlmod). It provides build support for the WAMR runtime library
without requiring foreign_cc rules.

For JIT support (WAMR_BUILD_JIT=1), LLVM 19.1.0 is included automatically.
Projects using //:vmlib_jit will get LLVM via git_override.

For projects using only //:vmlib (default), LLVM is not required.

See BAZEL.md for complete JIT configuration instructions.
"""

module(
    name = "wamr",
    version = "2.4.3",
    compatibility_level = 1,
)

# Core Bazel rules for C/C++ compilation
# Note: These versions are updated to match Bazel's dependency resolution
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.4")

# Optional: Bazel skylib for utility functions
bazel_dep(name = "bazel_skylib", version = "1.8.2")

# LLVM for JIT support - using archive_override to get version 19.1.0
# BCR only has LLVM 17.x, but we can use archive_override with BCR's patches
# to get LLVM 19.1.0 with full bzlmod support
bazel_dep(name = "llvm-project", dev_dependency = True)

# Use LLVM 19.1.0 with BCR's overlay patches for bzlmod support
archive_override(
    module_name = "llvm-project",
    urls = ["https://github.com/llvm/llvm-project/releases/download/llvmorg-19.1.0/llvm-project-19.1.0.src.tar.xz"],
    integrity = "sha256-+u/sZR/ON52CLjdJcJgUk6ByEHdCv/G02dSpjRw9fGo=",
    strip_prefix = "llvm-project-19.1.0.src",
    patches = [
        # These patches are from BCR's llvm-project, adapted for 19.1.0
        # They add MODULE.bazel, BUILD files, and Bazel overlay support
        "//bazel/llvm-patches:0001-Add-Bazel-files-to-.gitignore.patch",
        "//bazel/llvm-patches:0002-Add-LLVM-Bazel-overlay-files.patch",
        "//bazel/llvm-patches:0003-Add-MODULE.bazel.patch",
        "//bazel/llvm-patches:0004-Add-BUILD.bazel.patch",
        "//bazel/llvm-patches:0005-Add-Bazel-LLVM-targets.patch",
    ],
    patch_strip = 1,
)
