"""
MODULE.bazel - Bazel module definition for WebAssembly Micro Runtime (WAMR)

This file defines the WAMR module and its dependencies using Bazel's modern
module system (bzlmod). It provides build support for the WAMR runtime library
without requiring foreign_cc rules.

For JIT support (WAMR_BUILD_JIT=1), LLVM is required. LLVM is available in the
Bazel Central Registry and can be added as a dependency:

Example for JIT support:
    # In your MODULE.bazel
    bazel_dep(name = "wamr", version = "2.4.3")
    
    # Add LLVM from Bazel Central Registry
    bazel_dep(name = "llvm-project", version = "17.0.3.bcr.4", dev_dependency = True)
    
    # Or use a newer version if available
    # bazel_dep(name = "llvm-project", version = "18.1.8")

See BAZEL.md for complete JIT configuration instructions.
"""

module(
    name = "wamr",
    version = "2.4.3",
    compatibility_level = 1,
)

# Core Bazel rules for C/C++ compilation
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_cc", version = "0.0.9")

# Optional: Bazel skylib for utility functions
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# LLVM is required for JIT support but not included by default
# to keep the module lightweight for interpreter and AOT-only use cases.
# LLVM is available in Bazel Central Registry - see documentation above.
# Users who need JIT support should add llvm-project as a bazel_dep.
