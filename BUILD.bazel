"""
BUILD.bazel - Main build file for WebAssembly Micro Runtime (WAMR)

This file defines the main vmlib target which combines all WAMR components.
"""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Main WAMR runtime library (vmlib/libiwasm)
cc_library(
    name = "vmlib",
    hdrs = glob(["core/iwasm/include/*.h"]),
    copts = [
        "-std=gnu99",
        "-Wall",
        "-Wextra",
        "-Wformat",
        "-Wformat-security",
        "-ffunction-sections",
        "-fdata-sections",
        "-fvisibility=hidden",
        "-DWASM_ENABLE_INTERP=1",
        "-DWASM_ENABLE_AOT=1",
        "-DWASM_ENABLE_LIBC_BUILTIN=1",
        "-DWASM_ENABLE_LIBC_WASI=1",
        "-DWASM_ENABLE_FAST_INTERP=1",
        "-DWASM_ENABLE_SIMD=1",
        "-DWASM_ENABLE_REF_TYPES=1",
    ] + select({
        "@platforms//cpu:x86_64": ["-DBUILD_TARGET_X86_64"],
        "@platforms//cpu:aarch64": ["-DBUILD_TARGET_AARCH64"],
        "@platforms//cpu:arm": ["-DBUILD_TARGET_ARM"],
        "@platforms//cpu:riscv64": ["-DBUILD_TARGET_RISCV64_LP64D"],
        "//conditions:default": ["-DBUILD_TARGET_X86_64"],
    }),
    includes = ["core/iwasm/include"],
    linkopts = select({
        "@platforms//os:linux": [
            "-lm",
            "-ldl",
            "-lpthread",
        ],
        "@platforms//os:macos": [
            "-lm",
            "-lpthread",
        ],
        "@platforms//os:windows": [
            "-lws2_32",
            "-lntdll",
        ],
        "//conditions:default": [
            "-lm",
            "-ldl",
            "-lpthread",
        ],
    }),
    deps = [
        "//core/iwasm/aot",
        "//core/iwasm/common",
        "//core/iwasm/interpreter",
        "//core/iwasm/libraries/libc-builtin",
        "//core/iwasm/libraries/libc-wasi",
        "//core/shared/mem-alloc",
        "//core/shared/platform",
        "//core/shared/utils",
    ],
)

# Alias for compatibility
alias(
    name = "iwasm",
    actual = ":vmlib",
)
