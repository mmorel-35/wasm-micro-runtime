"""
BUILD.bazel - WASI libc library for WAMR

This library provides WASI (WebAssembly System Interface) libc implementation.
"""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "libc-wasi",
    srcs = glob(["**/*.c"]),
    hdrs = glob(["**/*.h"]),
    copts = [
        "-std=gnu99",
        "-ffunction-sections",
        "-fdata-sections",
        "-fvisibility=hidden",
        "-DWASM_ENABLE_LIBC_WASI=1",
    ],
    includes = [
        ".",
        "sandboxed-system-primitives/include",
        "sandboxed-system-primitives/src",
    ],
)
